DSN=ddadmin:password@tcp(mysql:3306)/divinedrop?charset=utf8mb4
CLERK_API_KEY=

# Origin that card images, mana symbols and user uploads are READ from, without
# a trailing slash.
CDN_URL=https://divinedrop.nyc3.cdn.digitaloceanspaces.com

# Object store that user uploads are WRITTEN to. Separate from CDN_URL: this is
# the S3 API endpoint, that one is the public origin the same objects are served
# over. Every value below falls back to the DigitalOcean Space the application
# has always used, so leaving them unset keeps current behaviour.
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_REGION=us-east-1
S3_BUCKET=divinedrop
# false addresses a bucket as a subdomain of the endpoint, which is what Spaces
# serves. Set true for an R2 account endpoint, which expects host/bucket/key.
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
